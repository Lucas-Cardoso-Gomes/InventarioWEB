@model IEnumerable<Web.Models.Chamado>

@{
    ViewData["Title"] = "Gestão de Chamados";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-headset"></i> @ViewData["Title"]</h2>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Novo Chamado</a>
            @if (User.IsInRole("Admin") || User.IsInRole("Diretoria/RH"))
            {
                <a asp-action="Dashboard" class="btn btn-info text-white"><i class="bi bi-bar-chart"></i> Dashboard</a>
            }
            @if (User.IsInRole("Admin"))
            {
                <form asp-controller="Chamados" asp-action="Importar" method="post" enctype="multipart/form-data" class="d-flex m-0">
                    <div class="input-group">
                        <input type="file" name="file" class="form-control form-control-sm" />
                        <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-file-earmark-excel"></i> Importar</button>
                    </div>
                </form>
            }
        </div>
    </div>

    @{
        var selectedStatuses = ViewBag.SelectedStatuses as List<string> ?? new List<string> { "Aberto", "Em Andamento" };
    }

    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light">
            <i class="bi bi-funnel"></i> <strong>Filtros de Pesquisa</strong>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get" id="chamados-filter-form">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="fw-bold form-label">Status</label>
                        <div class="border rounded p-2 bg-white" style="height: 120px; overflow-y: auto;">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="statuses" value="Aberto" id="statusAberto" @(selectedStatuses.Contains("Aberto") ? "checked" : "")>
                                <label class="form-check-label" for="statusAberto">Aberto</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="statuses" value="Em Andamento" id="statusEmAndamento" @(selectedStatuses.Contains("Em Andamento") ? "checked" : "")>
                                <label class="form-check-label" for="statusEmAndamento">Em Andamento</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="statuses" value="Fechado" id="statusFechado" @(selectedStatuses.Contains("Fechado") ? "checked" : "")>
                                <label class="form-check-label" for="statusFechado">Fechado</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="fw-bold form-label">TIC</label>
                        @{
                            var allAdmins = ViewBag.Admins as List<Web.Models.Colaborador> ?? new List<Web.Models.Colaborador>();
                            var selectedAdmins = ViewBag.SelectedAdmins as List<string> ?? new List<string>();
                        }
                        <div class="border rounded p-2 bg-white" style="height: 120px; overflow-y: auto;">
                            @foreach (var admin in allAdmins)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="selectedAdmins" value="@admin.CPF" id="admin-@admin.CPF" @(selectedAdmins.Contains(admin.CPF) ? "checked" : "")>
                                    <label class="form-check-label" for="admin-@admin.CPF">@admin.Nome</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="fw-bold form-label">Colaborador</label>
                        @{
                            var allColaboradores = ViewBag.Colaboradores as List<Web.Models.Colaborador> ?? new List<Web.Models.Colaborador>();
                            var selectedColaboradores = ViewBag.SelectedColaboradores as List<string> ?? new List<string>();
                        }
                        <div class="border rounded p-2 bg-white" style="height: 120px; overflow-y: auto;">
                            @foreach (var colab in allColaboradores)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="selectedColaboradores" value="@colab.CPF" id="colab-@colab.CPF" @(selectedColaboradores.Contains(colab.CPF) ? "checked" : "")>
                                    <label class="form-check-label" for="colab-@colab.CPF">@colab.Nome</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="fw-bold form-label">Serviço</label>
                        @{
                            var allServicos = ViewBag.Servicos as List<string> ?? new List<string>();
                            var selectedServicos = ViewBag.SelectedServicos as List<string> ?? new List<string>();
                        }
                        <div class="border rounded p-2 bg-white" style="height: 120px; overflow-y: auto;">
                            @foreach (var servico in allServicos)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="selectedServicos" value="@servico" id="serv-@servico.Replace(" ", "")" @(selectedServicos.Contains(servico) ? "checked" : "")>
                                    <label class="form-check-label" for="serv-@servico.Replace(" ", "")">@servico</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="fw-bold form-label">Pesquisa</label>
                        <input type="text" name="searchText" class="form-control" value="@ViewBag.SearchText" placeholder="Buscar por descrição ou serviço...">
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="fw-bold form-label">Data Início</label>
                        <input type="date" name="startDate" class="form-control" value="@(ViewBag.StartDate?.ToString("yyyy-MM-dd"))">
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="fw-bold form-label">Data Fim</label>
                        <input type="date" name="endDate" class="form-control" value="@(ViewBag.EndDate?.ToString("yyyy-MM-dd"))">
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Filtrar</button>
                    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Limpar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Técnico / Admin</th>
                    <th>Colaborador</th>
                    <th>Serviço</th>
                    <th>Última Alteração</th>
                    <th>Criação</th>
                    <th>Status</th>
                    <th>Prioridade</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.ID" class="fw-bold">#@item.ID</a>
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.AdminNome)</td>
                        <td>@Html.DisplayFor(modelItem => item.ColaboradorNome)</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.ID">@Html.DisplayFor(modelItem => item.Servico)</a>
                        </td>
                        <td>@(item.DataAlteracao.HasValue ? item.DataAlteracao.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</td>
                        <td>@item.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (item.Status == "Aberto")
                            {
                                <span class="badge bg-primary">Aberto</span>
                            }
                            else if (item.Status == "Em Andamento")
                            {
                                <span class="badge bg-warning text-dark">Em Andamento</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Fechado</span>
                            }
                        </td>
                        <td>
                            @if (item.Prioridade == "Crítico")
                            {
                                <span class="badge bg-danger">Crítico</span>
                            }
                            else if (item.Prioridade == "Alto")
                            {
                                <span class="badge bg-warning text-dark">Alto</span>
                            }
                            else if (item.Prioridade == "Médio")
                            {
                                <span class="badge bg-info text-dark">Médio</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Baixo</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-info btn-sm text-white me-1" title="Visualizar / Chat">Chat</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-warning btn-sm me-1" title="Editar">Editar</a>
                            }
                            @if (User.IsInRole("Admin") || (item.Status == "Aberto" && item.ColaboradorCPF == User.Claims.FirstOrDefault(c => c.Type == "ColaboradorCPF")?.Value && (DateTime.Now - item.DataCriacao).TotalMinutes <= 30))
                            {
                                <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-danger btn-sm me-1" title="Excluir">Excluir</a>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                @if (item.Status == "Aberto")
                                {
                                    <form asp-action="WorkingTicket" asp-route-id="@item.ID" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-info btn-sm text-white me-1" title="Iniciar Atendimento">Atender</button>
                                    </form>
                                }
                                else if (item.Status == "Em Andamento")
                                {
                                    <form asp-action="CloseTicket" asp-route-id="@item.ID" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-success btn-sm me-1" title="Fechar Chamado">Fechar</button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/chamado-filter-persistence.js" asp-append-version="true"></script>
}