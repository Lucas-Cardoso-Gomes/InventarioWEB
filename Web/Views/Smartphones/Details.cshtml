@model Web.Models.SmartphoneDetailsViewModel

@{
    ViewData["Title"] = "Detalhes do Smartphone";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-phone"></i> @ViewData["Title"] - @Model.Smartphone.Modelo</h2>
        <div>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Smartphone.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
            }
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Voltar</a>
        </div>
    </div>

    <ul class="nav nav-tabs" id="smartphoneTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="dados-tab" data-bs-toggle="tab" data-bs-target="#dados" type="button" role="tab" aria-controls="dados" aria-selected="true"><i class="bi bi-info-circle"></i> Informações do Ativo</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="trocas-tab" data-bs-toggle="tab" data-bs-target="#trocas" type="button" role="tab" aria-controls="trocas" aria-selected="false"><i class="bi bi-clock-history"></i> Histórico de Trocas</button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 p-4 bg-white" id="smartphoneTabsContent">

        <!-- Tab: Informações -->
        <div class="tab-pane fade show active" id="dados" role="tabpanel" aria-labelledby="dados-tab">
            <div class="row">
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header bg-light"><i class="bi bi-phone-fill"></i> <strong>Aparelho e Identificação</strong></div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>ID:</strong> @Model.Smartphone.Id</li>
                            <li class="list-group-item"><strong>Modelo:</strong> @Model.Smartphone.Modelo</li>
                            <li class="list-group-item"><strong>IMEI 1:</strong> @Model.Smartphone.IMEI1</li>
                            <li class="list-group-item"><strong>IMEI 2:</strong> @Model.Smartphone.IMEI2</li>
                            <li class="list-group-item"><strong>MAC Address:</strong> @Model.Smartphone.MAC</li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header bg-light"><i class="bi bi-person"></i> <strong>Usuário e Acessos</strong></div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>Usuário Responsável:</strong> @Model.Smartphone.Usuario</li>
                            <li class="list-group-item"><strong>Filial:</strong> @Model.Smartphone.Filial</li>
                            <li class="list-group-item"><strong>Conta Google:</strong> @Model.Smartphone.ContaGoogle</li>
                            <li class="list-group-item"><strong>Garantia:</strong> @(Model.Smartphone.DataGarantia.HasValue ? Model.Smartphone.DataGarantia.Value.ToString("dd/MM/yyyy") : "Não definida")</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab: Histórico de Trocas -->
        <div class="tab-pane fade" id="trocas" role="tabpanel" aria-labelledby="trocas-tab">
             @if (Model.HistoricoTrocas != null && Model.HistoricoTrocas.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Data da Alteração</th>
                                <th>Campo Alterado</th>
                                <th>Valor Antigo</th>
                                <th>Valor Novo</th>
                                <th>Usuário</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in Model.HistoricoTrocas)
                            {
                                <tr>
                                    <td>@(DateTime.TryParse(h.DataAlteracao, out var dt) ? dt.ToString("dd/MM/yyyy HH:mm:ss") : h.DataAlteracao)</td>
                                    <td>@h.CampoAlterado</td>
                                    <td>@h.ValorAntigo</td>
                                    <td>@h.ValorNovo</td>
                                    <td>@h.Usuario</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">Nenhum histórico de troca registrado para este equipamento.</div>
            }
        </div>

    </div>
</div>
