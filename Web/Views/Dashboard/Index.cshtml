@model Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard TI - Painel de Tomada de Decisão";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <style>
        .kpi-card {
            border: none;
            border-radius: 10px;
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
            cursor: pointer;
        }
        .kpi-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.1);
        }
        .kpi-icon {
            font-size: 2.2rem;
            opacity: 0.85;
        }
    </style>
}

<div class="container-fluid mt-4">
    <!-- Top Bar Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-speedometer2 text-primary"></i> Dashboard TI - Painel Decisório</h2>
            <p class="text-muted mb-0">Indicadores de saúde do parque tecnológico, riscos operacionais e substituição de ativos.</p>
        </div>
        <div>
            <a asp-controller="Exportar" asp-action="Index" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-1"></i> Exportar Relatório Gerencial</a>
        </div>
    </div>

    <!-- Global Filter Bar (Power BI Style) -->
    <div class="card mb-4 shadow-sm border-0 bg-light">
        <div class="card-body">
            <form asp-action="Index" method="get" id="dashboard-filter-form" class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-secondary">Filial</label>
                    <select name="filial" class="form-select form-select-sm">
                        <option value="">Todas as Filiais</option>
                        @foreach (var f in Model.Filiais)
                        {
                            <option value="@f" selected="@(Model.SelectedFilial == f)">@f</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-secondary">Setor</label>
                    <select name="setor" class="form-select form-select-sm">
                        <option value="">Todos os Setores</option>
                        @foreach (var s in Model.Setores)
                        {
                            <option value="@s" selected="@(Model.SelectedSetor == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-secondary">Dispositivo</label>
                    <select name="dispositivo" class="form-select form-select-sm">
                        <option value="">Todos os Tipos</option>
                        <option value="Computador" selected="@(Model.SelectedDispositivo == "Computador")">Computador</option>
                        <option value="Monitor" selected="@(Model.SelectedDispositivo == "Monitor")">Monitor</option>
                        <option value="Periférico" selected="@(Model.SelectedDispositivo == "Periférico")">Periférico</option>
                        <option value="Ativo de Rede" selected="@(Model.SelectedDispositivo == "Ativo de Rede")">Ativo de Rede</option>
                        <option value="Smartphone" selected="@(Model.SelectedDispositivo == "Smartphone")">Smartphone</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-secondary">Garantia</label>
                    <select name="statusGarantia" class="form-select form-select-sm">
                        <option value="">Todos</option>
                        <option value="Vencida" selected="@(Model.SelectedStatusGarantia == "Vencida")">Vencida</option>
                        <option value="Valida" selected="@(Model.SelectedStatusGarantia == "Valida")">Válida</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> Aplicar Filtros</button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i> Limpar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Actionable Risk & Decision KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-2 col-md-4">
            <div class="card kpi-card bg-danger text-white shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small fw-bold">GARANTIA VENCIDA</div>
                        <h2 class="mb-0 fw-bold">@Model.TotalGarantiasVencidas</h2>
                    </div>
                    <div class="kpi-icon"><i class="bi bi-exclamation-triangle"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4">
            <div class="card kpi-card bg-warning text-dark shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-dark-50 small fw-bold">AGENTES INATIVOS (>15d)</div>
                        <h2 class="mb-0 fw-bold">@Model.TotalAgentesInativos</h2>
                    </div>
                    <div class="kpi-icon"><i class="bi bi-wifi-off"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4">
            <div class="card kpi-card bg-secondary text-white shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small fw-bold">SEM BACKUP</div>
                        <h2 class="mb-0 fw-bold">@Model.TotalSemBackup</h2>
                    </div>
                    <div class="kpi-icon"><i class="bi bi-hdd-network"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4">
            <div class="card kpi-card bg-dark text-white shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small fw-bold">BATERIAS CRÍTICAS</div>
                        <h2 class="mb-0 fw-bold">@Model.BatteryCriticalCount</h2>
                    </div>
                    <div class="kpi-icon"><i class="bi bi-battery-10"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4">
            <div class="card kpi-card bg-primary text-white shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small fw-bold">CHAMADOS ABERTOS</div>
                        <h2 class="mb-0 fw-bold">@Model.TotalChamadosAbertos</h2>
                    </div>
                    <div class="kpi-icon"><i class="bi bi-headset"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4">
            <div class="card kpi-card bg-success text-white shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small fw-bold">TOTAL EQUIPAMENTOS</div>
                        <h2 class="mb-0 fw-bold">@Model.Equipamentos.Count</h2>
                    </div>
                    <div class="kpi-icon"><i class="bi bi-pc-display"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Power BI Charts Section -->
    <div class="row g-4 mb-4">
        <!-- Baterias -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-battery-charging text-warning me-1"></i> Desgaste de Baterias (Renovação de Hardware)</span>
                    <span class="badge bg-secondary">Média: @Model.AverageBatteryWear.ToString("0.0")%</span>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <canvas id="batteryWearPieChart" style="max-height: 220px;"></canvas>
                        </div>
                        <div class="col-md-6">
                            <h6 class="fw-bold text-muted mb-2">Piores Baterias (Ação Imediata)</h6>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <tbody>
                                        @foreach (var item in Model.TopWorstBatteries)
                                        {
                                            <tr>
                                                <td class="small fw-bold">@item.ModeloOuNome</td>
                                                <td>
                                                    <span class="badge bg-danger">@item.BateriaWearLevel?.ToString("0.0")%</span>
                                                </td>
                                            </tr>
                                        }
                                        @if (!Model.TopWorstBatteries.Any())
                                        {
                                            <tr><td colspan="2" class="text-muted small">Sem dados críticos.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Consumo de CPU -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-cpu text-danger me-1"></i> Sobrecarga de CPU (Gargalo de Desempenho)</span>
                    <span class="badge bg-secondary">Média: @Model.AverageCpuUsage.ToString("0.0")%</span>
                </div>
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <canvas id="cpuWearPieChart" style="max-height: 220px;"></canvas>
                        </div>
                        <div class="col-md-6">
                            <h6 class="fw-bold text-muted mb-2">Maiores Consumos (Gargalo)</h6>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <tbody>
                                        @foreach (var item in Model.TopWorstCpus)
                                        {
                                            <tr>
                                                <td class="small fw-bold">@item.ModeloOuNome</td>
                                                <td>
                                                    <span class="badge bg-danger">@item.CpuUsage?.ToString("0.0")%</span>
                                                </td>
                                            </tr>
                                        }
                                        @if (!Model.TopWorstCpus.Any())
                                        {
                                            <tr><td colspan="2" class="text-muted small">Sem dados de consumo.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Status de Garantias -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light fw-bold">
                    <i class="bi bi-pie-chart text-info me-1"></i> Distribuição das Garantias
                </div>
                <div class="card-body d-flex justify-content-center align-items-center">
                    <canvas id="garantiaPieChart" style="max-height: 220px;"></canvas>
                </div>
            </div>
        </div>

        <!-- Linha do Tempo de Garantias -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light fw-bold">
                    <i class="bi bi-bar-chart text-primary me-1"></i> Vencimento de Garantias (Linha do Tempo)
                </div>
                <div class="card-body">
                    <canvas id="garantiaBarChart" style="max-height: 220px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Interactive Decision Equipment Table -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <span><i class="bi bi-table me-1"></i> <strong>Matriz de Decisão & Inventário Geral</strong></span>
            <span class="badge bg-light text-dark">Exibindo @Model.Equipamentos.Count itens</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover align-middle" id="datatablesDashboard">
                    <thead class="table-dark">
                        <tr>
                            <th>Tipo</th>
                            <th>Identificador</th>
                            <th>Modelo / Nome</th>
                            <th>Responsável</th>
                            <th>Filial / Setor</th>
                            <th>Garantia</th>
                            <th>Backup</th>
                            <th>Última Coleta</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Equipamentos)
                        {
                            <tr>
                                <td>
                                    @if (item.TipoEquipamento == "Computador")
                                    {
                                        <span class="badge bg-primary"><i class="bi bi-pc me-1"></i>Computador</span>
                                    }
                                    else if (item.TipoEquipamento == "Monitor")
                                    {
                                        <span class="badge bg-success"><i class="bi bi-display me-1"></i>Monitor</span>
                                    }
                                    else if (item.TipoEquipamento == "Periférico")
                                    {
                                        <span class="badge bg-info text-dark"><i class="bi bi-mouse me-1"></i>Periférico</span>
                                    }
                                    else if (item.TipoEquipamento == "Ativo de Rede")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-hdd-network me-1"></i>Rede</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-phone me-1"></i>Smartphone</span>
                                    }
                                </td>
                                <td class="fw-bold">@item.Identificador</td>
                                <td>@item.ModeloOuNome</td>
                                <td>@(string.IsNullOrEmpty(item.ColaboradorNome) ? "Sem responsável" : item.ColaboradorNome)</td>
                                <td>@($"{item.Filial} / {item.Setor}".Trim(' ', '/'))</td>
                                <td>
                                    @if (item.DataGarantia.HasValue)
                                    {
                                        if (item.DataGarantia.Value < DateTime.Now)
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Vencida em @item.DataGarantia.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>@item.DataGarantia.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sem dados</span>
                                    }
                                </td>
                                <td>
                                    @if (item.TipoEquipamento == "Computador")
                                    {
                                        if (string.IsNullOrEmpty(item.Backup) || item.Backup.Equals("Não", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger">Não</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Sim</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (item.DataColeta.HasValue)
                                    {
                                        var dias = (DateTime.Now - item.DataColeta.Value).TotalDays;
                                        if (dias > 15)
                                        {
                                            <span class="badge bg-danger">@item.DataColeta.Value.ToString("dd/MM/yyyy") (Há @Math.Floor(dias) dias)</span>
                                        }
                                        else if (dias > 7)
                                        {
                                            <span class="badge bg-warning text-dark">@item.DataColeta.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="text-success small">@item.DataColeta.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">N/A</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @{
                                        string controller = item.TipoEquipamento switch
                                        {
                                            "Computador" => "Computadores",
                                            "Monitor" => "Monitores",
                                            "Periférico" => "Perifericos",
                                            "Ativo de Rede" => "Redes",
                                            _ => "Smartphones"
                                        };
                                    }
                                    <a asp-controller="@controller" asp-action="Details" asp-route-id="@item.Identificador" class="btn btn-sm btn-info text-white me-1" title="Detalhes do Ativo"><i class="bi bi-eye"></i></a>
                                    <a asp-controller="Chamados" asp-action="Create" class="btn btn-sm btn-outline-warning" title="Abrir Chamado"><i class="bi bi-headset"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            var dataTable;
            if ($.fn.DataTable) {
                dataTable = $('#datatablesDashboard').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json"
                    },
                    "pageLength": 10
                });
            }

            // Power BI Style Cross-Filtering helper
            function filterTable(searchTerm) {
                if (dataTable) {
                    dataTable.search(searchTerm).draw();
                }
            }

            // Battery Wear Pie Chart
            var ctxBatteryPie = document.getElementById("batteryWearPieChart");
            if (ctxBatteryPie) {
                var batteryGood = @Html.Raw(Json.Serialize(Model.BatteryGoodCount));
                var batteryWarning = @Html.Raw(Json.Serialize(Model.BatteryWarningCount));
                var batteryCritical = @Html.Raw(Json.Serialize(Model.BatteryCriticalCount));

                var batteryChart = new Chart(ctxBatteryPie, {
                    type: 'doughnut',
                    data: {
                        labels: ["Boa (0-24%)", "Atenção (25-49%)", "Crítica (50%+)"],
                        datasets: [{
                            data: [batteryGood, batteryWarning, batteryCritical],
                            backgroundColor: ['#28a745', '#ffc107', '#dc3545'],
                        }],
                    },
                    options: {
                        onClick: function(e, elements) {
                            if (elements.length > 0) {
                                var idx = elements[0].index;
                                var label = batteryChart.data.labels[idx];
                                filterTable(label.includes("Crítica") ? "Computador" : "");
                            }
                        }
                    }
                });
            }

            // CPU Usage Pie Chart
            var ctxCpuPie = document.getElementById("cpuWearPieChart");
            if (ctxCpuPie) {
                var cpuGood = @Html.Raw(Json.Serialize(Model.CpuGoodCount));
                var cpuWarning = @Html.Raw(Json.Serialize(Model.CpuWarningCount));
                var cpuCritical = @Html.Raw(Json.Serialize(Model.CpuCriticalCount));

                var cpuChart = new Chart(ctxCpuPie, {
                    type: 'doughnut',
                    data: {
                        labels: ["Normal (0-24%)", "Atenção (25-49%)", "Alto Uso (50%+)"],
                        datasets: [{
                            data: [cpuGood, cpuWarning, cpuCritical],
                            backgroundColor: ['#28a745', '#ffc107', '#dc3545'],
                        }],
                    },
                    options: {
                        onClick: function(e, elements) {
                            if (elements.length > 0) {
                                filterTable("Computador");
                            }
                        }
                    }
                });
            }

            // Pie Chart Garantia
            var ctxPie = document.getElementById("garantiaPieChart");
            if (ctxPie) {
                var pieData = @Html.Raw(Json.Serialize(Model.GarantiaPieData));
                var pieChart = new Chart(ctxPie, {
                    type: 'pie',
                    data: {
                        labels: ["Garantia Válida", "Garantia Vencida", "Sem dados"],
                        datasets: [{
                            data: pieData,
                            backgroundColor: ['#28a745', '#dc3545', '#6c757d'],
                        }],
                    },
                    options: {
                        onClick: function(e, elements) {
                            if (elements.length > 0) {
                                var idx = elements[0].index;
                                if (idx === 1) filterTable("Vencida");
                                else if (idx === 0) filterTable("Válida");
                                else filterTable("");
                            }
                        }
                    }
                });
            }

            // Bar Chart Garantias
            var ctxBar = document.getElementById("garantiaBarChart");
            if (ctxBar) {
                var barData = @Html.Raw(Json.Serialize(Model.GarantiaBarData));
                var labels = barData.map(function(d) { return d.label; });
                var data = barData.map(function(d) { return d.value; });
                new Chart(ctxBar, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: "Equipamentos a Vencer",
                            backgroundColor: "#0d6efd",
                            data: data,
                        }],
                    },
                    options: {
                        plugins: { legend: { display: false } }
                    }
                });
            }
        });
    </script>
}
