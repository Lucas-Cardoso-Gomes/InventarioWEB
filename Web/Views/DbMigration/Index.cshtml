@{
    ViewData["Title"] = "Migração de Dados";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-database-gear"></i> @ViewData["Title"]</h2>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> <strong>Migração SQL Server para SQLite</strong>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-circle me-1"></i>
                <strong>Atenção:</strong> Esta ação irá apagar todos os dados atuais do banco de dados local e importar os dados do SQL Server de origem.
            </div>

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-info">@ViewBag.Message</div>
            }

            <form asp-action="Migrate" method="post">
                <div class="mb-3">
                    <label for="connectionString" class="form-label fw-bold">String de Conexão do SQL Server (Origem):</label>
                    <input type="text" class="form-control" id="connectionString" name="connectionString" required placeholder="Server=seu_servidor;Database=seu_banco;User Id=seu_usuario;Password=sua_senha;TrustServerCertificate=True;">
                    <div class="form-text text-muted">Certifique-se de que a string de conexão está correta e que o servidor é acessível.</div>
                </div>
                <button type="submit" class="btn btn-danger" onclick="return confirm('Tem certeza? Isso apagará os dados locais!');"><i class="bi bi-play-circle"></i> Iniciar Migração</button>
            </form>
        </div>
    </div>
</div>
