<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom-style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    @RenderSection("Styles", required: false)
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Computadores" asp-action="Index">InventárioWEB</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdownInventario" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Inventário
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownInventario">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Computadores" asp-action="Index">Computadores</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Monitores" asp-action="Index">Monitores</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Perifericos" asp-action="Index">Periféricos</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Smartphones" asp-action="Index">Smartphones</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Redes" asp-action="Index">Ativos de Rede</a></li>
                                }
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdownOperacoes"
                                role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Operações
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdownOperacoes">
                                @if (User.IsInRole("Admin") || User.IsInRole("Coordenador"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Manutencoes"
                                            asp-action="Index">Manutenções</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Exportar"
                                            asp-action="Index">Exportar</a></li>
                                }
                                <li><a class="dropdown-item" asp-area="" asp-controller="Chamados"
                                        asp-action="Index">Chamados</a></li>
                                @if (User.IsInRole("Admin") || User.IsInRole("Diretoria/RH"))
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Feedbacks" asp-action="Index">Feedbacks</a></li>
                                }
                            </ul>
                        </li>

                        @if (User.IsInRole("Admin") || User.IsInRole("Diretoria/RH"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdownGerenciamento" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Gerenciamento
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdownGerenciamento">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Programas" asp-action="Index">Programas Instalados</a></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Colaboradores" asp-action="Index">Colaboradores</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Users" asp-action="Index">Usuários</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Gerenciamento" asp-action="Index">Gerenciamento Remoto</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Monitoramento" asp-action="Index">Monitoramento de Rede</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Gerenciamento" asp-action="Logs">Logs do Sistema</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="Gerenciamento" asp-action="PersistentLogs">Log Persistente</a></li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("Diretoria/RH"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold" asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard TI</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    @TempData["WarningMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted position-relative">
        <div class="container d-flex justify-content-between align-items-center">
            <span>&copy; 2024-2026 - Por Lucas Cardoso Gomes</span>
            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#feedbackModal">
                <i class="fas fa-comment-dots"></i> Feedback
            </button>
        </div>
    </footer>

    <!-- Feedback Modal -->
    <div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="feedbackModalLabel">Enviar Feedback</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/Feedbacks/Enviar" method="post">
                    <div class="modal-body">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="feedbackAssunto" class="form-label">Assunto</label>
                            <input type="text" class="form-control" id="feedbackAssunto" name="assunto" required>
                        </div>
                        <div class="mb-3">
                            <label for="feedbackMensagem" class="form-label">Mensagem (Sugestão, Crítica, etc)</label>
                            <textarea class="form-control" id="feedbackMensagem" name="mensagem" rows="3" required></textarea>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" value="true" id="feedbackAnonimo" name="isAnonimo">
                            <label class="form-check-label" for="feedbackAnonimo">
                                Enviar anonimamente
                            </label>
                        </div>
                        <div class="mt-2 text-center">
                            <a href="/Feedbacks/Acompanhar" class="text-decoration-none">Já enviou um feedback? Acompanhe aqui.</a>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Enviar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/select2-initializer.js" asp-append-version="true"></script>
    <script src="~/lib/signalr/signalr.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (Notification.permission !== "granted") {
                Notification.requestPermission();
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/notificationHub")
                .build();

            connection.on("ReceiveNotification", function (user, message) {
                if (Notification.permission === "granted") {
                    new Notification(user, {
                        body: message,
                        icon: "/favicon.ico"
                    });
                }
                // Se o usuário estiver na página de chamados, recarrega a página.
                if (window.location.pathname.toLowerCase().includes("/chamados")) {
                    location.reload();
                }
            });

            connection.on("ReceiveError", function (error, details) {
                console.error("Erro de notificação:", details);
                alert(error); // Mostra apenas a mensagem de erro genérica.
            });

            connection.start().catch(function (err) {
                return console.error(err.toString());
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
