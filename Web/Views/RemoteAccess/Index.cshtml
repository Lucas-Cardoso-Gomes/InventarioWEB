@using System.Text.Json
@{
    ViewData["Title"] = "Acesso Remoto";
    Layout = "~/Views/Shared/_RemoteAccessLayout.cshtml";
    string remoteIp = ViewBag.Ip as string ?? string.Empty;
}

@section Styles {
    <style>
        .remote-wrapper {
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100vh;
            overflow: hidden;
            background-color: #111;
            color: #f8f9fa;
        }

        .remote-toolbar {
            flex: 0 0 auto;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem;
            padding: 0.4rem 0.75rem;
            background-color: #1e2124;
            border-bottom: 1px solid #343a40;
        }

        .remote-toolbar-group {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.4rem;
        }

        #remote-screen-container {
            flex: 1 1 0;
            min-height: 0;
            width: 100%;
            overflow: hidden;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #000;
            outline: none;
        }

        #remote-screen-container:focus {
            box-shadow: inset 0 0 0 2px #0d6efd;
        }

        #remote-screen-container:fullscreen {
            width: 100vw;
            height: 100vh;
        }

        #screen {
            max-width: 100%;
            max-height: 100%;
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
            user-select: none;
            -webkit-user-drag: none;
        }
    </style>
}

<div class="remote-wrapper">
    <div id="remote-toolbar" class="remote-toolbar">
        <div class="remote-toolbar-group">
            <span class="fw-semibold me-1">Acesso Remoto: @remoteIp</span>
            <span id="ws-status-badge" class="badge bg-warning text-dark">Conectando...</span>
        </div>

        <div class="remote-toolbar-group">
            <button id="fullscreen-btn" type="button" class="btn btn-sm btn-secondary">Tela Cheia</button>
            <button id="lock-mouse-btn" type="button" class="btn btn-sm btn-primary">Travar Mouse</button>
            <button id="release-keys-btn" type="button" class="btn btn-sm btn-outline-light">Liberar teclas</button>
            <button id="open-taskmgr-btn" type="button" class="btn btn-sm btn-danger">Abrir Gerenciador de Tarefas</button>
        </div>

        <div class="remote-toolbar-group">
            <input type="file" id="file-input" class="form-control form-control-sm bg-dark text-light border-secondary" style="max-width: 220px;" />
            <button id="upload-file-btn" type="button" class="btn btn-sm btn-success">Enviar Arquivo</button>
            <span id="upload-status" class="small text-muted"></span>
        </div>
    </div>

    <div id="remote-screen-container" tabindex="0">
        <img id="screen" src="/RemoteAccess/GetScreenMJPEGStream?ip=@Uri.EscapeDataString(remoteIp)" alt="Tela remota" draggable="false" />
    </div>
</div>

@section Scripts {
    <script>
        const ip = @Html.Raw(JsonSerializer.Serialize(remoteIp));
        const encodedIp = encodeURIComponent(ip);

        const screenImg = document.getElementById("screen");
        const screenContainer = document.getElementById("remote-screen-container");
        const statusBadge = document.getElementById("ws-status-badge");
        const lockButton = document.getElementById("lock-mouse-btn");
        const taskMgrButton = document.getElementById("open-taskmgr-btn");
        const releaseKeysButton = document.getElementById("release-keys-btn");
        const fullscreenButton = document.getElementById("fullscreen-btn");
        const uploadButton = document.getElementById("upload-file-btn");
        const fileInput = document.getElementById("file-input");
        const uploadStatus = document.getElementById("upload-status");

        let isFullscreen = false;
        let ws = null;
        let reconnectDelay = 1000;
        let reconnectTimer = null;
        let isUnloading = false;

        let pendingMove = null;
        let accWheelY = 0;
        let accWheelX = 0;
        let rafScheduled = false;
        const virtualPos = { x: 0, y: 0 };
        const pressedButtons = new Set();

        function setStatus(text, badgeClass) {
            statusBadge.textContent = text;
            statusBadge.className = `badge ${badgeClass}`;
        }

        function send(line) {
            if (ws && ws.readyState === WebSocket.OPEN) {
                ws.send(line);
            }
        }

        function connectInputSocket() {
            if (isUnloading) return;
            if (reconnectTimer) {
                clearTimeout(reconnectTimer);
                reconnectTimer = null;
            }

            setStatus("Conectando...", "bg-warning text-dark");
            const proto = location.protocol === "https:" ? "wss" : "ws";
            const url = `${proto}://${location.host}/RemoteAccess/InputSocket?ip=${encodedIp}`;
            const socket = new WebSocket(url);
            ws = socket;

            socket.onopen = () => {
                if (ws !== socket) return;
                reconnectDelay = 1000;
                setStatus("Conectado", "bg-success");
            };

            socket.onclose = (ev) => {
                if (ws !== socket) return;
                ws = null;
                if (isUnloading) return;

                const reason = ev.reason ? ` (${ev.reason})` : "";
                setStatus(`Desconectado${reason}`, "bg-danger");

                const delay = reconnectDelay;
                reconnectDelay = Math.min(reconnectDelay * 2, 10000);
                reconnectTimer = setTimeout(connectInputSocket, delay);
            };

            socket.onerror = () => {
                if (ws !== socket) return;
                socket.close();
            };
        }

        connectInputSocket();

        function clamp(val, min, max) {
            return Math.max(min, Math.min(max, val));
        }

        function toRemote(e) {
            const nw = screenImg.naturalWidth;
            const nh = screenImg.naturalHeight;
            if (!nw || !nh) return null;

            const rect = screenImg.getBoundingClientRect();
            if (!rect.width || !rect.height) return null;

            const elemRatio = rect.width / rect.height;
            const imgRatio = nw / nh;
            let drawW, drawH, offsetX, offsetY;

            if (imgRatio > elemRatio) {
                drawW = rect.width;
                drawH = rect.width / imgRatio;
                offsetX = 0;
                offsetY = (rect.height - drawH) / 2;
            } else {
                drawH = rect.height;
                drawW = rect.height * imgRatio;
                offsetX = (rect.width - drawW) / 2;
                offsetY = 0;
            }

            const x = Math.round((e.clientX - rect.left - offsetX) * (nw / drawW));
            const y = Math.round((e.clientY - rect.top - offsetY) * (nh / drawH));

            return {
                x: clamp(x, 0, nw - 1),
                y: clamp(y, 0, nh - 1)
            };
        }

        function flushFrame() {
            rafScheduled = false;
            const lines = [];

            if (pendingMove) {
                lines.push(`m ${pendingMove.x} ${pendingMove.y}`);
                pendingMove = null;
            }

            const stepsY = Math.round(accWheelY / 100);
            if (stepsY !== 0) {
                lines.push(`w ${stepsY * 120}`);
                accWheelY -= stepsY * 100;
            }

            const stepsX = Math.round(accWheelX / 100);
            if (stepsX !== 0) {
                lines.push(`h ${stepsX * 120}`);
                accWheelX -= stepsX * 100;
            }

            if (lines.length > 0) {
                send(lines.join("\n"));
            }
        }

        function scheduleFrameFlush() {
            if (!rafScheduled) {
                rafScheduled = true;
                requestAnimationFrame(flushFrame);
            }
        }

        function isPointerLocked() {
            return document.pointerLockElement === screenImg || document.pointerLockElement === screenContainer;
        }

        function isRemoteFocused() {
            return document.activeElement === screenContainer ||
                document.activeElement === screenImg ||
                isFullscreen ||
                isPointerLocked();
        }

        function getCurrentPos(e) {
            if (isPointerLocked()) {
                if (!screenImg.naturalWidth || !screenImg.naturalHeight) return null;
                return {
                    x: clamp(Math.round(virtualPos.x), 0, screenImg.naturalWidth - 1),
                    y: clamp(Math.round(virtualPos.y), 0, screenImg.naturalHeight - 1)
                };
            }
            return toRemote(e);
        }

        screenImg.addEventListener("mousemove", (e) => {
            if (isPointerLocked()) return;
            const pos = toRemote(e);
            if (!pos) return;
            virtualPos.x = pos.x;
            virtualPos.y = pos.y;
            pendingMove = pos;
            scheduleFrameFlush();
        });

        function handleLockedMouseMove(e) {
            if (!screenImg.naturalWidth || !screenImg.naturalHeight) return;
            virtualPos.x = clamp(virtualPos.x + e.movementX, 0, screenImg.naturalWidth - 1);
            virtualPos.y = clamp(virtualPos.y + e.movementY, 0, screenImg.naturalHeight - 1);
            pendingMove = {
                x: Math.round(virtualPos.x),
                y: Math.round(virtualPos.y)
            };
            scheduleFrameFlush();
        }

        document.addEventListener("pointerlockchange", () => {
            if (isPointerLocked()) {
                if (screenImg.naturalWidth && screenImg.naturalHeight && virtualPos.x === 0 && virtualPos.y === 0) {
                    virtualPos.x = Math.floor(screenImg.naturalWidth / 2);
                    virtualPos.y = Math.floor(screenImg.naturalHeight / 2);
                }
                document.addEventListener("mousemove", handleLockedMouseMove, false);
            } else {
                document.removeEventListener("mousemove", handleLockedMouseMove, false);
            }
        });

        screenImg.addEventListener("mousedown", (e) => {
            e.preventDefault();
            screenContainer.focus({ preventScroll: true });
            const pos = getCurrentPos(e);
            if (!pos) return;
            pendingMove = null;
            pressedButtons.add(e.button);
            send(`d ${e.button} ${pos.x} ${pos.y}`);
        });

        window.addEventListener("mouseup", (e) => {
            if (!pressedButtons.has(e.button) && e.target !== screenImg) return;
            pressedButtons.delete(e.button);
            const pos = getCurrentPos(e);
            pendingMove = null;
            if (pos) {
                send(`u ${e.button} ${pos.x} ${pos.y}`);
            } else {
                send(`u ${e.button}`);
            }
        });

        screenImg.addEventListener("wheel", (e) => {
            e.preventDefault();
            if (!screenImg.naturalWidth) return;
            const mult = e.deltaMode === 1 ? 40 : 1;
            accWheelY += e.deltaY * mult;
            accWheelX += e.deltaX * mult;
            scheduleFrameFlush();
        }, { passive: false });

        screenImg.addEventListener("contextmenu", (e) => e.preventDefault());

        function handleKeyboard(e, state) {
            if (!isRemoteFocused()) return;
            e.preventDefault();
            e.stopPropagation();
            if (e.code) {
                send(`k ${e.code} ${state}`);
            }
        }

        document.addEventListener("keydown", (e) => handleKeyboard(e, "down"));
        document.addEventListener("keyup", (e) => handleKeyboard(e, "up"));

        function releaseAllRemoteKeys() {
            pressedButtons.clear();
            send("r");
        }

        window.addEventListener("blur", releaseAllRemoteKeys);
        screenContainer.addEventListener("blur", () => {
            if (!isFullscreen && !isPointerLocked()) {
                releaseAllRemoteKeys();
            }
        });
        document.addEventListener("visibilitychange", () => {
            if (document.hidden) {
                releaseAllRemoteKeys();
            }
        });
        window.addEventListener("beforeunload", () => {
            isUnloading = true;
            releaseAllRemoteKeys();
            if (ws) {
                ws.close();
            }
        });

        lockButton.addEventListener("click", () => {
            screenContainer.focus({ preventScroll: true });
            screenImg.requestPointerLock();
        });

        releaseKeysButton.addEventListener("click", () => {
            releaseAllRemoteKeys();
            screenContainer.focus({ preventScroll: true });
        });

        taskMgrButton.addEventListener("click", async () => {
            try {
                const resp = await fetch(`/RemoteAccess/OpenTaskManager?ip=${encodedIp}`, { method: "POST" });
                if (!resp.ok) {
                    alert("Falha ao abrir o Gerenciador de Tarefas no agente.");
                }
            } catch {
                alert("Erro de comunicação ao tentar abrir o Gerenciador de Tarefas.");
            }
        });

        fullscreenButton.addEventListener("click", () => {
            if (!document.fullscreenElement) {
                screenContainer.requestFullscreen().then(() => {
                    screenContainer.focus({ preventScroll: true });
                }).catch(err => {
                    alert(`Erro ao ativar tela cheia: ${err.message} (${err.name})`);
                });
            } else {
                document.exitFullscreen();
            }
        });

        document.addEventListener("fullscreenchange", () => {
            isFullscreen = document.fullscreenElement === screenContainer;
            if (isFullscreen) {
                screenContainer.focus({ preventScroll: true });
            }
        });

        document.addEventListener("copy", () => {
            if (isRemoteFocused()) return;
            const text = document.getSelection().toString();
            if (text) {
                fetch(`/RemoteAccess/SendClipboard?ip=${encodedIp}`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(text)
                });
            }
        });

        document.addEventListener("cut", () => {
            if (isRemoteFocused()) return;
            const text = document.getSelection().toString();
            if (text) {
                fetch(`/RemoteAccess/SendClipboard?ip=${encodedIp}`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(text)
                });
            }
        });

        document.addEventListener("paste", (e) => {
            if (isRemoteFocused()) return;
            e.preventDefault();
            fetch(`/RemoteAccess/GetClipboard?ip=${encodedIp}`)
                .then(response => response.text())
                .then(text => {
                    if (document.execCommand) {
                        document.execCommand("insertText", false, text);
                    } else if (navigator.clipboard) {
                        navigator.clipboard.writeText(text);
                    }
                });
        });

        uploadButton.addEventListener("click", async () => {
            const file = fileInput.files[0];
            if (!file) {
                uploadStatus.textContent = "Selecione um arquivo.";
                uploadStatus.className = "small text-warning";
                return;
            }

            uploadButton.disabled = true;
            uploadStatus.textContent = "Enviando...";
            uploadStatus.className = "small text-info";

            try {
                const formData = new FormData();
                formData.append("file", file);
                const response = await fetch(`/RemoteAccess/UploadFile?ip=${encodedIp}`, {
                    method: "POST",
                    body: formData
                });
                if (response.ok) {
                    uploadStatus.textContent = "Enviado para a Área de Trabalho.";
                    uploadStatus.className = "small text-success";
                    fileInput.value = "";
                } else {
                    uploadStatus.textContent = `Erro no envio (${response.status}).`;
                    uploadStatus.className = "small text-danger";
                }
            } catch {
                uploadStatus.textContent = "Falha de rede no envio.";
                uploadStatus.className = "small text-danger";
            } finally {
                uploadButton.disabled = false;
            }
        });
    </script>
}
