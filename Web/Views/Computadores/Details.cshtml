@model Web.Models.ComputadorDetailsViewModel

@{
    ViewData["Title"] = "Detalhes do Computador";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-pc-display"></i> @ViewData["Title"] - @Model.Computador.Hostname</h2>
        <div>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Computador.MAC" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
            }
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Voltar</a>
        </div>
    </div>

    <ul class="nav nav-tabs" id="computadorTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="dados-tab" data-bs-toggle="tab" data-bs-target="#dados" type="button" role="tab" aria-controls="dados" aria-selected="true"><i class="bi bi-info-circle"></i> Informações do Ativo</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="hardware-tab" data-bs-toggle="tab" data-bs-target="#hardware" type="button" role="tab" aria-controls="hardware" aria-selected="false"><i class="bi bi-cpu"></i> Hardware e Sistema</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="manutencao-tab" data-bs-toggle="tab" data-bs-target="#manutencao" type="button" role="tab" aria-controls="manutencao" aria-selected="false"><i class="bi bi-tools"></i> Histórico de Manutenções</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="trocas-tab" data-bs-toggle="tab" data-bs-target="#trocas" type="button" role="tab" aria-controls="trocas" aria-selected="false"><i class="bi bi-clock-history"></i> Histórico de Trocas</button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 p-4 bg-white" id="computadorTabsContent">

        <!-- Tab: Informações -->
        <div class="tab-pane fade show active" id="dados" role="tabpanel" aria-labelledby="dados-tab">
            <div class="row">
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header bg-light"><i class="bi bi-diagram-3"></i> <strong>Rede e Identificação</strong></div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>MAC Address:</strong> @Model.Computador.MAC</li>
                            <li class="list-group-item"><strong>IP:</strong> @Model.Computador.IP</li>
                            <li class="list-group-item"><strong>Hostname:</strong> @Model.Computador.Hostname</li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header bg-light"><i class="bi bi-person"></i> <strong>Usuário e Localização</strong></div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>Colaborador:</strong> @(Model.Computador.ColaboradorNome ?? "Nenhum")</li>
                            <li class="list-group-item"><strong>Localização:</strong> @Model.Computador.Localizacao</li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header bg-light"><i class="bi bi-building"></i> <strong>Fabricante e Garantia</strong></div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>Fabricante:</strong> @Model.Computador.Fabricante</li>
                            <li class="list-group-item"><strong>Part Number:</strong> @Model.Computador.PartNumber</li>
                            <li class="list-group-item"><strong>Garantia:</strong> @(Model.Computador.DataGarantia.HasValue ? Model.Computador.DataGarantia.Value.ToString("dd/MM/yyyy") : "Não definida")</li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header bg-light"><i class="bi bi-activity"></i> <strong>Status</strong></div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>Última Coleta:</strong> @(Model.Computador.DataColeta.HasValue ? Model.Computador.DataColeta.Value.ToString("dd/MM/yyyy HH:mm:ss") : "N/A")</li>
                            <li class="list-group-item"><strong>Tempo de Atividade:</strong> @Model.Computador.TempoAtividade</li>
                            <li class="list-group-item"><strong>Wear Level Bateria:</strong> @Model.Computador.BateriaWearLevel</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab: Hardware -->
        <div class="tab-pane fade" id="hardware" role="tabpanel" aria-labelledby="hardware-tab">
             <div class="row">
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header bg-light"><strong>Processador</strong></div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>Modelo:</strong> @Model.Computador.Processador</li>
                            <li class="list-group-item"><strong>Fabricante:</strong> @Model.Computador.ProcessadorFabricante</li>
                            <li class="list-group-item"><strong>Cores/Threads:</strong> @Model.Computador.ProcessadorCore / @Model.Computador.ProcessadorThread</li>
                            <li class="list-group-item"><strong>Clock:</strong> @Model.Computador.ProcessadorClock</li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header bg-light"><strong>Memória RAM</strong></div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>Total:</strong> @Model.Computador.Ram</li>
                            <li class="list-group-item"><strong>Tipo:</strong> @Model.Computador.RamTipo</li>
                            <li class="list-group-item"><strong>Velocidade:</strong> @Model.Computador.RamVelocidade</li>
                        </ul>
                    </div>
                </div>
                 <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header bg-light"><strong>Armazenamento C:</strong></div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>Modelo:</strong> @Model.Computador.ArmazenamentoC</li>
                            <li class="list-group-item"><strong>Total:</strong> @Model.Computador.ArmazenamentoCTotal</li>
                            <li class="list-group-item"><strong>Livre:</strong> @Model.Computador.ArmazenamentoCLivre</li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header bg-light"><strong>Sistema Operacional e Backup</strong></div>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>SO:</strong> @Model.Computador.SO</li>
                            <li class="list-group-item"><strong>Backup:</strong> @Model.Computador.Backup</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab: Manutenções -->
        <div class="tab-pane fade" id="manutencao" role="tabpanel" aria-labelledby="manutencao-tab">
            @if (Model.HistoricoManutencoes != null && Model.HistoricoManutencoes.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Data Manutenção</th>
                                <th>HW/SW/Externa</th>
                                <th>Histórico</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.HistoricoManutencoes.OrderByDescending(x => x.Data))
                            {
                                <tr>
                                    <td>@m.Data</td>
                                    <td>
                                        @if(m.DataManutencaoHardware.HasValue){<span class="badge bg-primary me-1">HW: @m.DataManutencaoHardware.Value.ToString("dd/MM/yyyy")</span>}
                                        @if(m.DataManutencaoSoftware.HasValue){<span class="badge bg-info me-1">SW: @m.DataManutencaoSoftware.Value.ToString("dd/MM/yyyy")</span>}
                                        @if(!string.IsNullOrEmpty(m.ManutencaoExterna)){<span class="badge bg-secondary">EXT: @m.ManutencaoExterna</span>}
                                    </td>
                                    <td>@m.Historico</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">Nenhuma manutenção registrada para este equipamento.</div>
            }
        </div>

        <!-- Tab: Histórico de Trocas -->
        <div class="tab-pane fade" id="trocas" role="tabpanel" aria-labelledby="trocas-tab">
             @if (Model.HistoricoTrocas != null && Model.HistoricoTrocas.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Data da Alteração</th>
                                <th>Campo Alterado</th>
                                <th>Valor Antigo</th>
                                <th>Valor Novo</th>
                                <th>Usuário</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in Model.HistoricoTrocas)
                            {
                                <tr>
                                    <td>@(DateTime.TryParse(h.DataAlteracao, out var dt) ? dt.ToString("dd/MM/yyyy HH:mm:ss") : h.DataAlteracao)</td>
                                    <td>@h.CampoAlterado</td>
                                    <td>@h.ValorAntigo</td>
                                    <td>@h.ValorNovo</td>
                                    <td>@h.Usuario</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">Nenhum histórico de troca registrado para este equipamento.</div>
            }
        </div>

    </div>
</div>
