@model Web.Models.Feedback
@{
    ViewData["Title"] = "Detalhes do Feedback";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-chat-left-text"></i> @ViewData["Title"] #@Model.ID - @Model.Assunto</h2>
        <div>
            @if (User.IsInRole("Admin") || User.IsInRole("Diretoria/RH"))
            {
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Voltar à Lista</a>
            }
            else
            {
                <a href="/" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Voltar ao Início</a>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-light">
                    <i class="bi bi-info-circle"></i> <strong>Informações Gerais</strong>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">ID:</dt>
                        <dd class="col-sm-8">#@Model.ID</dd>

                        <dt class="col-sm-4">Protocolo:</dt>
                        <dd class="col-sm-8"><span class="badge bg-dark">@Model.Protocolo</span></dd>

                        <dt class="col-sm-4">Autor:</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.UsuarioCPF) ? "Anônimo" : Model.AutorNome)</dd>

                        <dt class="col-sm-4">Data:</dt>
                        <dd class="col-sm-8">@Model.DataCriacao.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            @if (Model.Status == "Aberto")
                            {
                                <span class="badge bg-primary">Aberto</span>
                            }
                            else if (Model.Status == "Em Andamento")
                            {
                                <span class="badge bg-warning text-dark">Em Andamento</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Fechado</span>
                            }
                        </dd>
                    </dl>
                </div>
                @if (Model.Status != "Fechado")
                {
                    <div class="card-footer bg-white border-top-0">
                        <form asp-action="Close" asp-route-id="@Model.ID" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-danger w-100" onclick="return confirm('Deseja realmente encerrar este feedback?');"><i class="bi bi-x-circle"></i> Encerrar Feedback</button>
                        </form>
                    </div>
                }
            </div>
        </div>

        <div class="col-md-8">
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-envelope"></i> <strong>Assunto:</strong> @Model.Assunto</span>
                </div>
                <div class="card-body">
                    <div class="p-3 bg-light border rounded mb-3">
                        <strong>Mensagem Original:</strong><br />
                        @Model.Mensagem
                    </div>

                    <hr />
                    <h5 class="mb-3"><i class="bi bi-chat-dots"></i> Conversa (Anotações/Respostas)</h5>
                    <div class="chat-container mb-3 p-3 bg-light border rounded" style="max-height: 400px; overflow-y: auto;">
                        @if (Model.Conversas != null && Model.Conversas.Any())
                        {
                            foreach (var conv in Model.Conversas)
                            {
                                <div class="mb-2 p-2 bg-white border rounded">
                                    <strong>@conv.Remetente:</strong> @conv.Mensagem
                                    <div class="text-muted small mt-1">@conv.DataCriacao.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-3">Nenhuma mensagem adicional.</div>
                        }
                    </div>

                    @if (Model.Status != "Fechado")
                    {
                        <form asp-action="SendMessage" method="post">
                            <input type="hidden" name="feedbackId" value="@Model.ID" />
                            @if (!User.Identity.IsAuthenticated)
                            {
                                <input type="hidden" name="remetente" value="Autor" />
                            }
                            <div class="input-group">
                                <input type="text" name="mensagem" class="form-control" placeholder="Adicionar nota ou resposta..." required />
                                <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Enviar</button>
                            </div>
                        </form>
                        @if (User.IsInRole("Admin") || User.IsInRole("Diretoria/RH"))
                        {
                            <small class="text-muted mt-2 d-block">Nota: O autor anônimo não recebe notificação ativa, ele precisará verificar usando o protocolo.</small>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
