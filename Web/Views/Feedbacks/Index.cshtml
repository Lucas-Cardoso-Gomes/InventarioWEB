@model IEnumerable<Web.Models.Feedback>
@{
    ViewData["Title"] = "Gestão de Feedbacks";
}

<h1>Feedbacks e Sugestões</h1>

<div class="card mb-4">
    <div class="card-header">
        <i class="fas fa-comments me-1"></i>
        Lista de Feedbacks Recebidos
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover align-middle" id="datatablesSimple">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Assunto</th>
                        <th>Autor</th>
                        <th>Data</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ID</td>
                            <td>@item.Assunto</td>
                            <td>
                                @if (string.IsNullOrEmpty(item.UsuarioCPF))
                                {
                                    <span class="badge bg-secondary">Anônimo</span>
                                }
                                else
                                {
                                    @item.AutorNome
                                }
                            </td>
                            <td>@item.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if(item.Status == "Aberto")
                                {
                                    <span class="badge bg-primary">Aberto</span>
                                }
                                else if(item.Status == "Em Andamento")
                                {
                                    <span class="badge bg-warning text-dark">Em Andamento</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Fechado</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info text-white"><i class="fas fa-eye"></i> Detalhes</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($.fn.DataTable) {
                $('#datatablesSimple').DataTable({
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/pt-BR.json"
                    },
                    "order": [[3, "desc"]] // Sort by date descending
                });
            }
        });
    </script>
}
