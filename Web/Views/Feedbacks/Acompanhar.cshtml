@{
    ViewData["Title"] = "Acompanhar Feedback";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0"><i class="bi bi-search me-2"></i>Acompanhar Feedback</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted text-center mb-4">Insira o código de protocolo gerado no momento do envio para verificar o andamento ou adicionar novas informações ao seu feedback.</p>

                    <form asp-action="Acompanhar" method="get">
                        <div class="input-group mb-3">
                            <span class="input-group-text"><i class="bi bi-hash"></i></span>
                            <input type="text" class="form-control form-control-lg text-center fw-bold text-uppercase" id="protocolo" name="protocolo" placeholder="FDK-123456" required>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg"><i class="bi bi-search"></i> Consultar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
