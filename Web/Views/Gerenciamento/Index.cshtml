@{
    ViewData["Title"] = "Painel de Gerenciamento";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-gear"></i> @ViewData["Title"]</h2>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card text-center h-100 shadow-sm">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="display-6 text-primary mb-3"><i class="bi bi-arrow-repeat"></i></div>
                        <h5 class="card-title">Coletar Hardware</h5>
                        <p class="card-text text-muted">Inicie uma varredura na rede para coletar ou atualizar as informações de hardware dos computadores.</p>
                    </div>
                    <a asp-action="Coletar" class="btn btn-primary"><i class="bi bi-play-circle"></i> Iniciar Coleta</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center h-100 shadow-sm">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="display-6 text-warning mb-3"><i class="bi bi-terminal"></i></div>
                        <h5 class="card-title">Executar Comandos</h5>
                        <p class="card-text text-muted">Envie comandos remotos para serem executados nos computadores selecionados.</p>
                    </div>
                    <a asp-action="Comandos" class="btn btn-warning text-dark"><i class="bi bi-terminal"></i> Enviar Comando</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center h-100 shadow-sm">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="display-6 text-info mb-3"><i class="bi bi-display"></i></div>
                        <h5 class="card-title">Acesso Remoto</h5>
                        <p class="card-text text-muted">Digite o endereço de IP do computador que deseja acessar remotamente.</p>
                    </div>
                    <form asp-controller="RemoteAccess" asp-action="Index" method="get" target="_blank">
                        <div class="input-group">
                            <input type="text" name="ip" class="form-control form-control-sm" placeholder="Ex: 192.168.1.10" required>
                            <button class="btn btn-sm btn-info text-white" type="submit"><i class="bi bi-box-arrow-up-right"></i> Acessar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center h-100 shadow-sm">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="display-6 text-secondary mb-3"><i class="bi bi-app-indicator"></i></div>
                        <h5 class="card-title">Coletar Programas</h5>
                        <p class="card-text text-muted">Inicie uma varredura para extrair e inventariar os programas instalados nas máquinas.</p>
                    </div>
                    <a asp-action="Programas" class="btn btn-secondary"><i class="bi bi-download"></i> Coletar Programas</a>
                </div>
            </div>
        </div>
    </div>
</div>
