@model Web.Models.ColetaViewModel

@{
    ViewData["Title"] = "Coletar Programas Instalados";
}

<div class="container mt-4">
    <h2><i class="bi bi-app-indicator me-2"></i>@ViewData["Title"]</h2>
    <p class="text-muted">Utilize as opções abaixo para iniciar a coleta de programas instalados de um computador específico ou de uma faixa de rede. Os equipamentos devem estar ligados e com o agente em execução.</p>
    <hr />

    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0"><i class="bi bi-hdd-network me-2"></i>Coleta por IP ou Hostname</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Programas" method="post" class="coletaForm">
                        <input type="hidden" name="TipoColeta" value="ip" />
                        <div class="mb-3">
                            <label asp-for="IpAddress" class="form-label fw-bold">Endereço IP ou Hostname</label>
                            <input asp-for="IpAddress" class="form-control" placeholder="Ex: 10.0.0.5 ou PC-01" required />
                            <span asp-validation-for="IpAddress" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-secondary submitBtn">
                            <span class="spinner-border spinner-border-sm d-none me-1" role="status" aria-hidden="true"></span>
                            <i class="bi bi-download btn-icon me-1"></i> Coletar Programas
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0"><i class="bi bi-diagram-3 me-2"></i>Coleta por Faixa de Rede</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Programas" method="post" class="coletaForm">
                        <input type="hidden" name="TipoColeta" value="range" />
                        <div class="mb-3">
                            <label asp-for="IpRange" class="form-label fw-bold">Faixa de IP</label>
                            <select asp-for="IpRange" class="form-select">
                                <option value="all">Todas as faixas (10.0.0.* até 10.4.4.*)</option>
                                <option value="10.0.0.">10.0.0.x</option>
                                <option value="10.0.1.">10.0.1.x</option>
                                <option value="10.0.2.">10.0.2.x</option>
                                <option value="10.1.1.">10.1.1.x</option>
                                <option value="10.1.2.">10.1.2.x</option>
                                <option value="10.2.2.">10.2.2.x</option>
                                <option value="10.3.3.">10.3.3.x</option>
                                <option value="10.4.4.">10.4.4.x</option>
                            </select>
                            <span asp-validation-for="IpRange" class="text-danger"></span>
                            <div class="form-text mt-1">Varreduras completas executam em segundo plano. Você pode acompanhar o progresso nos Logs.</div>
                        </div>
                        <button type="submit" class="btn btn-secondary submitBtn">
                            <span class="spinner-border spinner-border-sm d-none me-1" role="status" aria-hidden="true"></span>
                            <i class="bi bi-play-circle btn-icon me-1"></i> Iniciar Varredura
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model.ColetaIniciada)
    {
        <hr class="my-4" />
        <div class="card border-info shadow-sm mb-4">
            <div class="card-header bg-info bg-opacity-10 text-dark">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Status da Execução</h5>
            </div>
            <div class="card-body">
                <p class="mb-2">A coleta foi iniciada em segundo plano. Os resultados aparecerão abaixo e no histórico do sistema:</p>
                @if (Model.Resultados.Any())
                {
                    <ul class="mb-3">
                        @foreach (var resultado in Model.Resultados)
                        {
                            <li>@resultado</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Nenhum resultado ainda. A varredura pode estar em andamento.</p>
                }
                <a href="/Gerenciamento/Logs" class="btn btn-sm btn-outline-dark"><i class="bi bi-journal-text me-1"></i> Acompanhar Progresso nos Logs</a>
            </div>
        </div>
    }

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Voltar ao Gerenciamento</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('.coletaForm').submit(function () {
                var btn = $(this).find('.submitBtn');
                btn.find('.spinner-border').removeClass('d-none');
                btn.find('.btn-icon').addClass('d-none');
                btn.prop('disabled', true);
            });
        });
    </script>
}
